          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Data.SqlClient;
using System.Globalization;
using Microsoft.SqlServer.Dts.Runtime;
#endregion

namespace ST_e3f2f33fb7b54f9dba01ee42d08e5483
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            string connStr = "Data Source=PG04CRRX;Initial Catalog=covid_dw;Integrated Security=SSPI;";

            using (var conn = new SqlConnection(connStr))
            {
                conn.Open();

                // Force date_id to start from 1 every run regardless of identity counter
                new SqlCommand("SET IDENTITY_INSERT dbo.dim_date ON;", conn).ExecuteNonQuery();

                DateTime start = new DateTime(2020, 1, 1);
                DateTime end = DateTime.Today;
                var cal = CultureInfo.InvariantCulture.Calendar;
                int dateId = 1;

                for (DateTime d = start; d <= end; d = d.AddDays(1))
                {
                    string monthName = d.ToString("MMMM");
                    string quarter = "Q" + ((d.Month - 1) / 3 + 1).ToString();
                    int weekNumber = cal.GetWeekOfYear(d,
                                           CalendarWeekRule.FirstFourDayWeek,
                                           DayOfWeek.Monday);
                    string dayOfWeek = d.DayOfWeek.ToString();
                    int isWeekend = (d.DayOfWeek == DayOfWeek.Saturday ||
                                        d.DayOfWeek == DayOfWeek.Sunday) ? 1 : 0;

                    string sql = @"INSERT INTO dbo.dim_date
                        (date_id, date, year, month, month_name, quarter,
                         week_number, day_of_week, is_weekend)
                        VALUES (@id,@date,@yr,@mo,@mn,@q,@wk,@dw,@iw)";

                    using (var cmd = new SqlCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue("@id", dateId++);
                        cmd.Parameters.AddWithValue("@date", d);
                        cmd.Parameters.AddWithValue("@yr", d.Year);
                        cmd.Parameters.AddWithValue("@mo", d.Month);
                        cmd.Parameters.AddWithValue("@mn", monthName);
                        cmd.Parameters.AddWithValue("@q", quarter);
                        cmd.Parameters.AddWithValue("@wk", weekNumber);
                        cmd.Parameters.AddWithValue("@dw", dayOfWeek);
                        cmd.Parameters.AddWithValue("@iw", isWeekend);
                        cmd.ExecuteNonQuery();
                    }
                }

                new SqlCommand("SET IDENTITY_INSERT dbo.dim_date OFF;", conn).ExecuteNonQuery();
            }

            Dts.TaskResult = (int)ScriptResults.Success;
        }

        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
    }
}]]></ProjectItem>
